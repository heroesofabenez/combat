{
    "name": "heroesofabenez/combat",
    "description": "Combat library for PHP applications",
    "keywords": [
      "combat"
    ],
    "license": "BSD-3-Clause",
    "homepage": "https://heroesofabenez.gitlab.io",
    "authors": [
        {
            "name": "Jakub Konečný",
            "email": "jakub.konecny2@centrum.cz",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://heroesofabenez.gitlab.io/combat"
    },
    "require": {
        "php": ">=8.3.0",
        "latte/latte": "^2.8 || ^3.0",
        "nette/utils": "^3.2.2 || ^4.0",
        "nexendrie/translation": "^2.5",
        "nexendrie/utils": "^1.11 || ^2.0",
        "symfony/options-resolver": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "nexendrie/code-quality": "dev-mytester",
        "phpstan/phpstan-nette": "^2.0",
        "nette/bootstrap": "^3.2",
        "nette/application": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "HeroesofAbenez\\Combat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HeroesofAbenez\\Combat\\": "tests/HeroesofAbenez/Combat/"
        }
    },
    "config": {
        "classmap-authoritative": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
